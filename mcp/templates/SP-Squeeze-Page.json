                { "id": "sp-t3d", "type": "text", "content": { "text": "на чтение материала", "fontSize": "14px", "color": "#6b7280", "textAlign": "center" }, "settings": { "padding": "0", "margin": "0", "backgroundColor": "transparent", "borderRadius": "0" } }
