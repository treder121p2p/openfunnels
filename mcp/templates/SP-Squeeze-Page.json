              "width": 33.33,
              "blocks": [
                { "id": "sp-t3i", "type": "text", "content": { "text": "🚀", "fontSize": "36px", "textAlign": "center" }, "settings": { "padding": "8px", "margin": "0 0 8px 0", "backgroundColor": "transparent", "borderRadius": "0" } },
