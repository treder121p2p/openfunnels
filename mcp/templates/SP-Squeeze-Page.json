                { "id": "sp-t2t", "type": "text", "content": { "text": "4.9/5.0", "fontSize": "24px", "color": "#111827", "fontWeight": "800", "textAlign": "center" }, "settings": { "padding": "0", "margin": "0 0 4px 0", "backgroundColor": "transparent", "borderRadius": "0" } },
                { "id": "sp-t2d", "type": "text", "content": { "text": "средняя оценка", "fontSize": "14px", "color": "#6b7280", "textAlign": "center" }, "settings": { "padding": "0", "margin": "0", "backgroundColor": "transparent", "borderRadius": "0" } }
              ],
              "settings": { "padding": "16px", "backgroundColor": "transparent", "verticalAlign": "top" }
